@SistemaDeInventarioWebAPI_HostAddress = https://localhost:7001
@SistemaDeInventarioWebAPI_HostAddress_Http = http://localhost:5000

# ============================================
# ?? AUTENTICACIÓN
# ============================================

### Auth - Login (obtener token JWT)
POST {{SistemaDeInventarioWebAPI_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@sistema.com",
  "password": "Admin123!"
}

###

### Auth - Validar credenciales
POST {{SistemaDeInventarioWebAPI_HostAddress}}/api/auth/validate
Content-Type: application/json

{
  "email": "admin@sistema.com",
  "password": "Admin123!"
}

###

# ============================================
# ?? ROLES
# ============================================

### Roles - Obtener todos los roles
GET {{SistemaDeInventarioWebAPI_HostAddress}}/api/roles
Accept: application/json

###

### Roles - Obtener rol por ID
GET {{SistemaDeInventarioWebAPI_HostAddress}}/api/roles/1
Accept: application/json

###

### Roles - Crear nuevo rol
POST {{SistemaDeInventarioWebAPI_HostAddress}}/api/roles
Content-Type: application/json

{
  "nombre": "Supervisor",
  "descripcion": "Supervisor de almacén"
}

###

# ============================================
# ?? USUARIOS
# ============================================

### Usuarios - Obtener todos
GET {{SistemaDeInventarioWebAPI_HostAddress}}/api/usuarios
Accept: application/json

###

### Usuarios - Obtener activos
GET {{SistemaDeInventarioWebAPI_HostAddress}}/api/usuarios/activos
Accept: application/json

###

### Usuarios - Obtener por ID
GET {{SistemaDeInventarioWebAPI_HostAddress}}/api/usuarios/1
Accept: application/json

###

### Usuarios - Obtener por email
GET {{SistemaDeInventarioWebAPI_HostAddress}}/api/usuarios/email/admin@sistema.com
Accept: application/json

###

### Usuarios - Crear nuevo usuario
POST {{SistemaDeInventarioWebAPI_HostAddress}}/api/usuarios
Content-Type: application/json

{
  "nombreCompleto": "Juan Pérez",
  "email": "juan.perez@sistema.com",
  "password": "Juan123!",
  "rolId": 1
}

###

### Usuarios - Actualizar usuario
PUT {{SistemaDeInventarioWebAPI_HostAddress}}/api/usuarios/1
Content-Type: application/json

{
  "usuarioId": 1,
  "nombreCompleto": "Juan Pérez Actualizado",
  "email": "juan.perez@sistema.com",
  "rolId": 1,
  "activo": true
}

###

### Usuarios - Eliminar usuario (soft delete)
DELETE {{SistemaDeInventarioWebAPI_HostAddress}}/api/usuarios/1

###

